<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.taska.storybook-watchdog</string>
	<key>ProcessType</key>
	<string>Standard</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>-u</string>
		<string>/Users/yadong/dev2/taska/v2/tools/storybook-watchdog.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/yadong/dev2/taska/.logs/storybook-watchdog-error.log</string>
	<key>StandardOutPath</key>
	<string>/Users/yadong/dev2/taska/.logs/storybook-watchdog.log</string>
