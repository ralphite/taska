{
  "name": "taska-app-web",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "check:architecture": "node scripts/check-architecture.mjs --self",
    "test": "vitest run",
    "storybook": "storybook dev -p 6007 --no-open",
    "build-storybook": "storybook build -o dist-storybook --quiet",
    "e2e": "playwright test",
    "typecheck:server": "pyright -p ../server",
    "test:server": "python3 -m unittest discover -s ../tests -p \"test_*.py\"",
    "check": "tsc -b && eslint . && npm run check:architecture && vitest run && npm run typecheck:server && npm run test:server"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "markdown-it": "^15.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-themes": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "pyright": "^1.1.414",
    "storybook": "^10.6.2",
    "storybook-addon-pseudo-states": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
