<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.taska.storybook-app</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__PROJECT_ROOT__/tools/storybook-service.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__PROJECT_ROOT__/.logs/storybook-app-error.log</string>
	<key>StandardOutPath</key>
	<string>__PROJECT_ROOT__/.logs/storybook-app.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>WorkingDirectory</key>
	<string>__PROJECT_ROOT__/web</string>
</dict>
</plist>
