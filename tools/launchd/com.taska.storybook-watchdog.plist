<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.taska.storybook-watchdog</string>
	<key>ProcessType</key>
	<string>Standard</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PYTHON__</string>
		<string>-u</string>
		<string>__PROJECT_ROOT__/tools/storybook-watchdog.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__PROJECT_ROOT__/.logs/storybook-watchdog-error.log</string>
	<key>StandardOutPath</key>
	<string>__PROJECT_ROOT__/.logs/storybook-watchdog.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
</dict>
</plist>
